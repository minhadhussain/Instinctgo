{
  "name": "@instinctgo/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:documents": "node scripts/prepare-document-workers.mjs",
    "prepare:case": "tsx scripts/prepare-first-case.mts",
    "postinstall": "npm run prepare:documents",
    "predev": "npm run prepare:documents && npm run prepare:case",
    "prebuild": "npm run prepare:documents && npm run prepare:case",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:playground": "tsx --test tests/playground.test.ts",
    "test:deployment": "tsx --test tests/deployment.test.ts",
    "test:sws": "tsx --test tests/sws.test.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "clsx": "^2.1.1",
    "docx": "^9.15.1",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.65.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.3",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
