{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "buildCommand": "python scripts/prepare-vercel.py",
      "functions": {
        "app/main.py": {
          "maxDuration": 120,
          "includeFiles": "resources/noting/**",
          "excludeFiles": "{tests/**,.venv/**,.pytest_cache/**,.ruff_cache/**,data/**,storage/**}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "buildCommand": "npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
