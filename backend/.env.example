APP_NAME=InstinctGo API
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# SQLite works immediately; apply migrations before starting the API.
# Relative SQLite paths are resolved from the backend directory.
DATABASE_URL=sqlite+aiosqlite:///./data/instinctgo.db
# To connect to an existing PostgreSQL instance, use:
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/instinctgo
REDIS_URL=redis://localhost:6379/0

# Needed for AI note and workflow drafting; local noting works without this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=60

# Vercel: configure these values in the project environment settings.
# DATABASE_URL must use managed PostgreSQL for saved-workflow operations.
# VERCEL is provided by the platform; do not set it in this file.
